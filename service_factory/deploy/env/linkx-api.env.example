PORT=8100
FLASK_ENV=production
PYTHONUNBUFFERED=1
LINKX_SECRET_ENCRYPTION_KEY=change-me-generate-with-python-fernet
LINKX_FLASK_SECRET_KEY=change-me
LINKX_CORS_ORIGINS=https://frontend.example.com
DATABASE_URL=postgresql://linkx:change-me@control-data.example.internal:5432/linkx
LINKX_POSTGRES_DSN=postgresql://linkx:change-me@control-data.example.internal:5432/linkx
LINKX_REDIS_URL=redis://:change-me@control-data.example.internal:6379/0
LINKX_ARTIFACT_ROOT=/mnt/linkx-artifacts

# Infrastructure Endpoints
LINKX_ACTIVE_STORAGE_ADDRESS=storage.example.internal
LINKX_ELASTIC_API_BASE_URL=http://storage.example.internal:5000
LINKX_KAFKA_BOOTSTRAP_SERVERS=broker1.example.internal:9092,broker2.example.internal:9092,broker3.example.internal:9092
LINKX_ACTIVE_TOOL_PROTOCOL=neo4j://graph.example.internal:7687
LINKX_ENABLE_METRICS=false
LINKX_METRICS_TOKEN=

LINKX_MAX_JSON_BYTES=2097152
LINKX_AI_ALLOWED_SESSION_IDS=
LINKX_AI_ALLOW_GLOBAL_READ=false

# External Parent/OIDC/JWKS integrations must use HTTPS unless an explicit private-network exception is approved.
LINKX_PARENT_AUTH_ALLOW_HTTP=false
LINKX_PARENT_AUTH_ALLOWED_HOSTS=parent.example.com
LINKX_PARENT_AUTH_BASE_URL=https://parent.example.com
LINKX_PARENT_JWT_JWKS_URL=https://parent.example.com/.well-known/jwks.json
LINKX_PARENT_SSO_TOKEN_URL=https://parent.example.com/sso/token
LINKX_PARENT_SSO_USERINFO_URL=https://parent.example.com/sso/userinfo
LINKX_PARENT_SSO_REVOKE_URL=https://parent.example.com/sso/revoke
