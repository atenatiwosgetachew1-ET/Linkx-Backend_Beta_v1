[Unit]
Description=LinkX API / RBAC / Socket Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/linkx-backend-api/src
EnvironmentFile=/opt/linkx-backend-api/.env
ExecStart=/opt/linkx-backend-api/.venv/bin/python -u main.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
