# LinkX API service environment for Server 1.
# Copy to .env and change secrets/hosts before deployment.

PORT=8100
FLASK_ENV=production
PYTHONUNBUFFERED=1
LINKX_SECRET_ENCRYPTION_KEY=change-me-generate-with-python-fernet

LINKX_FLASK_SECRET_KEY=change-me
LINKX_CORS_ORIGINS=http://172.27.23.21,http://172.27.23.107
LINKX_ALLOWED_CONNECT_HOSTS=control-data.example.internal,data-storage.example.internal,elastic-api.example.internal,graph.example.internal
LINKX_MAX_UPLOAD_BYTES=104857600
LINKX_MAX_JSON_BYTES=2097152
LINKX_AUTH_ISSUER=linkx-api
LINKX_AUTH_AUDIENCE=linkx-frontend
LINKX_AUTH_TOKEN_SECONDS=1800
LINKX_LOGIN_RATE_LIMIT=5
LINKX_LOGIN_RATE_WINDOW_SECONDS=60
LINKX_SERVICE_TOKEN_RATE_LIMIT=10
LINKX_SERVICE_TOKEN_RATE_WINDOW_SECONDS=60
LINKX_PARENT_TOKEN_RATE_LIMIT=30
LINKX_PARENT_TOKEN_RATE_WINDOW_SECONDS=60
LINKX_PARENT_OAUTH_EXCHANGE_RATE_LIMIT=30
LINKX_PARENT_OAUTH_EXCHANGE_RATE_WINDOW_SECONDS=60
LINKX_ENABLE_LEGACY_PARENT_TOKEN=false
LINKX_PARENT_AUTH_BASE_URL=http://parent-auth.example.internal:3001
LINKX_PARENT_AUTH_ALLOWED_HOSTS=parent-auth.example.internal
LINKX_PARENT_AUTH_ALLOW_HTTP=true
LINKX_PARENT_AUTH_TIMEOUT_SECONDS=5
LINKX_PARENT_SSO_TOKEN_URL=http://parent-auth.example.internal:3001/sso/token
LINKX_PARENT_SSO_USERINFO_URL=http://parent-auth.example.internal:3001/sso/userinfo
LINKX_PARENT_SSO_REVOKE_URL=http://parent-auth.example.internal:3001/sso/revoke
LINKX_PARENT_OAUTH_CLIENT_ID=linkx-analysis-platform
LINKX_PARENT_OAUTH_CLIENT_SECRET=change-me-store-securely
LINKX_PARENT_OAUTH_REDIRECT_URI=http://172.27.23.21/auth/callback
LINKX_PARENT_OAUTH_ALLOWED_REDIRECT_URIS=http://172.27.23.21/auth/callback,https://172.27.23.21/auth/callback,http://localhost:3000/auth/callback
LINKX_PARENT_REQUIRE_LINKX_PERMISSION=true
LINKX_PARENT_PERMISSION_READ=LinkAnalysisRead
LINKX_PARENT_PERMISSION_MANAGE=LinkAnalysisManage
LINKX_PARENT_JWKS_URL=http://parent-auth.example.internal:3001/.well-known/jwks.json
LINKX_PARENT_JWT_JWKS_URL=http://parent-auth.example.internal:3001/.well-known/jwks.json
LINKX_PARENT_JWKS_CACHE_SECONDS=3600
LINKX_PARENT_JWT_PUBLIC_KEY_FILE=
LINKX_PARENT_JWT_PUBLIC_KEY=
LINKX_PARENT_JWT_LEEWAY_SECONDS=30
# Optional when the parent JWT includes iss/aud claims.
LINKX_PARENT_JWT_ISSUER=
LINKX_PARENT_JWT_AUDIENCE=
# Leave empty for Parent project iframe support; use CSP frame-ancestors instead.
LINKX_FRAME_OPTIONS=
LINKX_PARENT_FRAME_ORIGIN=http://172.27.23.107
LINKX_CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'self' http://172.27.23.107
LINKX_ENABLE_HSTS=false
# Keep Neo4j cleanup credentials in cleanup-worker env, not cleanup_runs.summary.
LINKX_STORE_CLEANUP_CREDENTIALS=false

# Async workload offload. Search remains synchronous until the frontend polls job results.
LINKX_ASYNC_WORKER_JOBS=true
LINKX_ASYNC_SEARCH_JOBS=false

# Graph status sockets send short-lived metadata and relationship summaries only.
LINKX_GRAPH_STATUS_METADATA_INTERVAL=2
LINKX_GRAPH_STATUS_METADATA_MAX_CYCLES=2
LINKX_GRAPH_STATUS_RELATIONSHIPS_ACTIVE_INTERVAL=3
LINKX_GRAPH_STATUS_RELATIONSHIPS_IDLE_INTERVAL=10
LINKX_GRAPH_STATUS_RELATIONSHIPS_IDLE_AFTER_CYCLES=2

# Server 2: PostgreSQL + Redis
DATABASE_URL=postgresql://linkx:change-me@control-data.example.internal:5432/linkx
LINKX_POSTGRES_DSN=postgresql://linkx:change-me@control-data.example.internal:5432/linkx
LINKX_REDIS_URL=redis://control-data.example.internal:6379/0

# Shared artifact storage mounted on Server 1 and workers.
LINKX_ARTIFACT_ROOT=/mnt/linkx-artifacts

# Transitional defaults used by current API compatibility routes.
LINKX_STORAGE_PATH=user/bank/cleaned_partitioned

# Data processing / Hadoop cluster endpoints.
# WebHDFS is used only for connection checks and file listing.
LINKX_ACTIVE_STORAGE_ADDRESS=data-storage.example.internal
LINKX_ACTIVE_STORAGE_HOST=data-storage.example.internal
LINKX_STORAGE_WEBHDFS_PORT=9870
LINKX_STORAGE_WEBHDFS_URL=http://data-storage.example.internal:9870

# Spark/HDFS reads should use the HDFS RPC URI, not the WebHDFS or Spark UI port.
LINKX_HDFS_RPC_PORT=8020
LINKX_STORAGE_HDFS_URI=hdfs://data-storage.example.internal:8020

# Hive/Spark SQL endpoints.
LINKX_HIVE_SERVER_HOST=data-storage.example.internal
LINKX_HIVE_PORT=10000
LINKX_THRIFT_PORT=9083
LINKX_HIVE_METASTORE_URI=thrift://data-storage.example.internal:9083

# Elasticsearch search API can live on a different host from Hadoop.
LINKX_ELASTIC_API_BASE_URL=http://elastic-api.example.internal:5000
LINKX_ELASTIC_API_PORT=5000
LINKX_ES_FUZZY_ENDPOINT=api/search/individual
LINKX_ES_STRICT_ENDPOINT=api/search/ui
LINKX_ACTIVE_TOOL=neo4j
LINKX_ACTIVE_TOOL_PROTOCOL=neo4j://graph.example.internal
LINKX_TOOL_PROTOCOL_PORT=7687
LINKX_ACTIVE_TOOL_USERNAME=neo4j
LINKX_ACTIVE_TOOL_PASSWORD=change-me
