# LinkX API service environment for Server 1.
# Copy to .env and change secrets/hosts before deployment.

PORT=8100
FLASK_ENV=production
PYTHONUNBUFFERED=1

LINKX_FLASK_SECRET_KEY=change-me
LINKX_CORS_ORIGINS=https://frontend.example.com
LINKX_MAX_UPLOAD_BYTES=104857600

# Server 2: PostgreSQL + Redis
DATABASE_URL=postgresql://linkx:change-me@control-data.example.internal:5432/linkx
LINKX_POSTGRES_DSN=postgresql://linkx:change-me@control-data.example.internal:5432/linkx
LINKX_REDIS_URL=redis://control-data.example.internal:6379/0

# Shared artifact storage mounted on Server 1 and workers.
LINKX_ARTIFACT_ROOT=/mnt/linkx-artifacts

# Transitional defaults used by current API compatibility routes.
LINKX_STORAGE_PATH=user/bank/cleaned_partitioned
LINKX_ACTIVE_TOOL=neo4j
LINKX_ACTIVE_TOOL_PROTOCOL=neo4j://graph.example.internal
LINKX_TOOL_PROTOCOL_PORT=7687
LINKX_ACTIVE_TOOL_USERNAME=neo4j
LINKX_ACTIVE_TOOL_PASSWORD=change-me
