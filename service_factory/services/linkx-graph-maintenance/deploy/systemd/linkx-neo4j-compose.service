[Unit]
Description=LinkX Neo4j Compose Service
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/linkx-graph-maintenance
RemainAfterExit=yes
ExecStart=/usr/bin/docker compose up -d neo4j
ExecStop=/usr/bin/docker compose stop neo4j
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
