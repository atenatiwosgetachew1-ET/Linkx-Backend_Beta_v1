[Unit]
Description=LinkX Cleanup Scheduler
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/linkx-graph-maintenance/src
EnvironmentFile=/opt/linkx-graph-maintenance/.env
ExecStart=/opt/linkx-graph-maintenance/.venv/bin/python -m linkx_cleanup.scheduler
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
