[Unit]
Description=LinkX Cleanup Worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/linkx-graph-maintenance/src
EnvironmentFile=/opt/linkx-graph-maintenance/.env
ExecStart=/opt/linkx-graph-maintenance/.venv/bin/python -m linkx_cleanup.worker
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
