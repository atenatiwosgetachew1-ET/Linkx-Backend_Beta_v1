# LinkX graph-maintenance service environment for Server 4.
# Copy to .env and change credentials/hosts before deployment.

PYTHONUNBUFFERED=1

# Server 2: PostgreSQL + Redis
DATABASE_URL=postgresql://linkx:change-me@control-data.example.internal:5432/linkx
LINKX_POSTGRES_DSN=postgresql://linkx:change-me@control-data.example.internal:5432/linkx
LINKX_REDIS_URL=redis://control-data.example.internal:6379/0

# Shared artifact storage mounted on Server 4.
LINKX_ARTIFACT_ROOT=/mnt/linkx-artifacts

# Local Neo4j target for final deployment on Server 4.
LINKX_NEO4J_URL=neo4j://127.0.0.1:7687
LINKX_NEO4J_USERNAME=neo4j
LINKX_NEO4J_PASSWORD=change-me
LINKX_CLEANUP_NEO4J_URL=neo4j://127.0.0.1:7687
LINKX_CLEANUP_NEO4J_USERNAME=neo4j
LINKX_CLEANUP_NEO4J_PASSWORD=change-me
# Required when cleanup resolves Neo4j passwords from managed_secrets via password_ref.
LINKX_SECRET_ENCRYPTION_KEY=

# Neo4j container settings.
NEO4J_AUTH=neo4j/change-me
NEO4J_server_memory_heap_initial__size=4G
NEO4J_server_memory_heap_max__size=4G
NEO4J_server_memory_pagecache_size=8G

# Cleanup behavior.
CLEANUP_WORKER_NAME=linkx-cleanup-1
CLEANUP_POLL_INTERVAL=5
CLEANUP_SCHEDULE_INTERVAL_SECONDS=3600
CLEANUP_DRY_RUN=false
CLEANUP_ARTIFACT_LIMIT=500
LINKX_METADATA_RETENTION_DAYS=30
LINKX_UPLOAD_RETENTION_DAYS=7
LINKX_DFPART_RETENTION_DAYS=3
LINKX_LOG_RETENTION_DAYS=30
LINKX_CONFIG_RETENTION_DAYS=7
LINKX_GRAPH_RETENTION_DAYS=14
