[Unit]
Description=LinkX Risk Scoring Kafka Consumer Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/linkx-worker/src
EnvironmentFile=/opt/linkx-worker/.env
ExecStart=/opt/linkx-worker/.venv/bin/python -m linkx_worker.risk_scoring_consumer
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
