[Unit]
Description=LinkX xReport Relay Daemon
After=network.target linkx-worker.service

[Service]
Type=simple
WorkingDirectory=/opt/linkx-worker/src
EnvironmentFile=/opt/linkx-worker/.env
ExecStart=/opt/linkx-worker/.venv/bin/python /opt/linkx-worker/src/linkx_worker/linkx_xreport.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
