# LinkX control-data service environment for Server 2.
# Copy to .env and change credentials before deployment.

POSTGRES_DB=linkx
POSTGRES_USER=linkx
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_PASSWORD=change-me

# Optional bootstrap users consumed by API bootstrap code.
LINKX_BOOTSTRAP_SUPERUSER_USERNAME=
LINKX_BOOTSTRAP_SUPERUSER_PASSWORD=
LINKX_BOOTSTRAP_ADMIN_USERNAME=
LINKX_BOOTSTRAP_ADMIN_PASSWORD=
