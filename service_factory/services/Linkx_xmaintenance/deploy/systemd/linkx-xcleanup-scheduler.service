[Unit]
Description=LinkX Cleanup Scheduler
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/Linkx_xmaintenance/src
EnvironmentFile=/opt/Linkx_xmaintenance/.env
ExecStart=/opt/Linkx_xmaintenance/.venv/bin/python -m linkx_xcleanup.scheduler
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
