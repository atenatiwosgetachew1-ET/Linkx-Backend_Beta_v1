# Factory-local defaults. Copy to .env for local service_factory development.
# These values intentionally avoid the live backend's port 8000.

PORT=8100
FLASK_ENV=development
PYTHONUNBUFFERED=1

LINKX_FLASK_SECRET_KEY=dev-factory-change-me
LINKX_CORS_ORIGINS=*
LINKX_MAX_UPLOAD_BYTES=104857600

# Future split-service contracts.
DATABASE_URL=postgresql://linkx:change-me@control-data.example.internal:5432/linkx
LINKX_POSTGRES_DSN=postgresql://linkx:linkx@127.0.0.1:55432/linkx
LINKX_REDIS_URL=redis://127.0.0.1:16379/0
LINKX_ARTIFACT_ROOT=/mnt/linkx-artifacts

# Neo4j defaults for local/factory testing only.
LINKX_NEO4J_URL=neo4j://127.0.0.1:17687
LINKX_NEO4J_USERNAME=neo4j
LINKX_NEO4J_PASSWORD=linkx-factory-password
